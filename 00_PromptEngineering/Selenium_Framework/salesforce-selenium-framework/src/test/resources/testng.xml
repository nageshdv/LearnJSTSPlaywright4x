<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Salesforce Login Automation Suite" verbose="1" parallel="tests" thread-count="2">

    <test name="Valid Login Tests" preserve-order="true">
        <classes>
            <class name="com.salesforce.tests.LoginValidTest"/>
        </classes>
    </test>

    <test name="Invalid Login Tests" preserve-order="true">
        <classes>
            <class name="com.salesforce.tests.LoginInvalidTest"/>
        </classes>
    </test>

</suite>
